# .env.example — copy to .env and fill in real values.
#
# IMPORTANT: never commit .env. Add `.env` to your .gitignore.

# ---------------------------------------------------------------------------
# Required: n8n API connection
# ---------------------------------------------------------------------------

# Base URL of your n8n instance. Choose one:
#   - Local n8n on this machine (Docker host):  http://host.docker.internal:5678
#   - n8n running in the same compose stack:    http://n8n:5678
#   - Remote / cloud n8n:                       https://n8n.your-domain.com
N8N_API_URL=http://host.docker.internal:5678

# API key from n8n: Settings -> n8n API -> Create API key.
# The key looks like: n8n_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Generate one and paste it here (no quotes).
N8N_API_KEY=replace-me-with-your-n8n-api-key

# ---------------------------------------------------------------------------
# Optional: only needed if you uncomment the `n8n` service in
# docker-compose.yml and want to run n8n itself in this stack.
# ---------------------------------------------------------------------------

# N8N_HOST=localhost
# N8N_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32
# GENERIC_TIMEZONE=America/New_York