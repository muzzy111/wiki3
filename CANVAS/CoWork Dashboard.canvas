{
  "nodes": [
    {
      "id": "fleet_live",
      "type": "text",
      "text": "# LOOP CoWork Dashboard — Fleet Live State\n\n> Single-page fleet dashboard. All numbers are live fetches against\n> Prometheus (`http://localhost:9090`) and loopd (`http://localhost:9101`).\n> Degrades to placeholder text if any source is unreachable.\n\n## Fleet Status\n\n```dataviewjs\nconst PROM = \"http://localhost:9090/api/v1/query\";\nconst LOOPD = \"http://localhost:9101/metrics\";\nconst q = (expr) => PROM + \"?query=\" + encodeURIComponent(expr);\n\nasync function get(expr) {\n  try {\n    const r = await fetch(q(expr));\n    if (!r.ok) return null;\n    const j = await r.json();\n    return j?.data?.result?.[0]?.value?.[1];\n  } catch (e) { return null; }\n}\n\nconst el = dv.el(\"div\", \"\");\nel.style.cssText = \"font-family: ui-monospace, Menlo, Consolas, monospace; line-height:1.55;\";\n\nconst card = (title, body) => {\n  const c = document.createElement(\"div\");\n  c.style.cssText = \"padding:10px 14px; margin:6px 0; border:1px solid rgba(255,255,255,0.08); border-radius:8px; background:rgba(17,24,39,0.35);\";\n  const h = document.createElement(\"div\");\n  h.style.cssText = \"font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#94a3b8; margin-bottom:6px;\";\n  h.textContent = title;\n  c.appendChild(h);\n  const b = document.createElement(\"div\");\n  b.style.cssText = \"font-size:14px; color:#e2e8f0;\";\n  if (typeof body === \"string\") b.textContent = body;\n  else c.appendChild(body);\n  c.appendChild(b);\n  el.appendChild(c);\n};\n\n// Live fleet up/down summary\nconst loopdUp  = await get(\"up{job=\\\"loopd\\\"}\");\nconst promUp   = await get(\"up{job=\\\"prometheus\\\"}\");\nconst natsUp   = await get(\"up{job=\\\"nats\\\"}\");\nconst nodeUp   = await get(\"up{job=\\\"node-exporter\\\"}\");\nconst cadvUp   = await get(\"up{job=\\\"cadvisor\\\"}\");\n\nconst upTxt = (v) => v === \"1\" ? \"UP\" : (v === \"0\" ? \"DOWN\" : \"N/A\");\nconst summary =\n  \"loopd: \" + upTxt(loopdUp) + \"  |  \" +\n  \"prometheus: \" + upTxt(promUp) + \"  |  \" +\n  \"nats: \" + upTxt(natsUp) + \"  |  \" +\n  \"node-exporter: \" + upTxt(nodeUp) + \"  |  \" +\n  \"cadvisor: \" + upTxt(cadvUp);\ncard(\"Service Status\", summary);\n\n// Per-agent table — pulled from kanban + loopd counters if reachable\nconst tbl = document.createElement(\"table\");\ntbl.style.cssText = \"width:100%; border-collapse:collapse; font-size:13px;\";\ntbl.innerHTML = \"<thead><tr style=\\\"text-align:left; color:#94a3b8;\\\">\" +\n  \"<th style=\\\"padding:4px;\\\">Agent</th>\" +\n  \"<th style=\\\"padding:4px;\\\">Status</th>\" +\n  \"<th style=\\\"padding:4px;\\\">Last Activity</th>\" +\n  \"<th style=\\\"padding:4px;\\\">Current Task</th>\" +\n  \"</tr></thead><tbody></tbody>\";\nconst tbody = tbl.querySelector(\"tbody\");\n\n// 1) Try to pull per-agent counters from loopd\nlet counters = {};\ntry {\n  const r = await fetch(LOOPD);\n  if (r.ok) {\n    const txt = await r.text();\n    for (const line of txt.split(\"\\n\")) {\n      const m = line.match(/^agent_(\\w+)\\{role=\\\"([^\\\"]+)\\\"\\}\\s+(\\S+)/);\n      if (m) counters[m[2]] = counters[m[2]] || {};\n      if (m) counters[m[2]][m[1]] = m[3];\n    }\n  }\n} catch (e) {}\n\nconst agents = [\"hermes\",\"claude\",\"cline\",\"grok\",\"opencode\",\"mavis\",\"antigravity\",\"copilot\",\"openwork\",\"ollama\"];\n\n// 2) Kanban: try to read current task per agent\nconst tasks = {};\ntry {\n  const kb = app.vault.getAbstractFileByPath(\"TASKS/KANBAN/Kanban Board.md\");\n  if (kb) {\n    const txt = await app.vault.read(kb);\n    for (const row of txt.split(\"\\n\")) {\n      if (!row.startsWith(\"|\") || row.startsWith(\"|---\") || row.startsWith(\"| ID\")) continue;\n      const cols = row.split(\"|\").map(s => s.trim());\n      if (cols.length < 5) continue;\n      const [id, title, status, owner] = cols;\n      if (owner) tasks[owner] = id + \" \" + title + \" (\" + status + \")\";\n    }\n  }\n} catch (e) {}\n\n// 3) Outbox: last activity per agent = newest outbox file mtime\nasync function lastActivity(agent) {\n  const p = \"agents/\" + agent + \"/CHAT/Outbox\";\n  try {\n    const f = app.vault.getAbstractFileByPath(p);\n    if (!f || !f.children) return null;\n    const files = f.children.filter(x => typeof x.stat === \"function\");\n    if (!files.length) return null;\n    files.sort((a,b) => b.stat.mtime - a.stat.mtime);\n    return new Date(files[0].stat.mtime).toISOString().slice(0,16).replace(\"T\",\" \");\n  } catch (e) { return null; }\n}\n\nfor (const a of agents) {\n  const tr = document.createElement(\"tr\");\n  const status = counters[a] ? \"ACTIVE\" : (loopdUp === \"1\" ? \"UNKNOWN\" : \"OFFLINE\");\n  const lastA = await lastActivity(a);\n  const task = tasks[a] || \"(no kanban row)\";\n  tr.innerHTML =\n    \"<td style=\\\"padding:4px; border-bottom:1px solid rgba(255,255,255,0.05);\\\">\" + a + \"</td>\" +\n    \"<td style=\\\"padding:4px; border-bottom:1px solid rgba(255,255,255,0.05);\\\">\" + status + \"</td>\" +\n    \"<td style=\\\"padding:4px; border-bottom:1px solid rgba(255,255,255,0.05);\\\">\" + (lastA || \"n/a\") + \"</td>\" +\n    \"<td style=\\\"padding:4px; border-bottom:1px solid rgba(255,255,255,0.05);\\\">\" + task + \"</td>\";\n  tbody.appendChild(tr);\n}\n\ncard(\"Agents\", tbl);\n\nconst stamp = document.createElement(\"div\");\nstamp.style.cssText = \"margin-top:10px; font-size:11px; color:#64748b;\";\nstamp.textContent = \"rendered \" + new Date().toISOString();\nel.appendChild(stamp);\n```\n\n## See Also\n\n- `[[SYSTEM/METERS]]`\n- `[[CANVAS/Projects]]`\n- `[[agents/hermes/DASHBOARD]]`\n",
      "x": 0,
      "y": 0,
      "width": 980,
      "height": 780,
      "color": "1"
    }
  ],
