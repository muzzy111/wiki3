# Required: host-side path to the backend inbox directory.
# Inside the container this is /data/inbox; from Windows, point at the bind mount.
SCRAPER_INBOX_PATH=C:\Users\Admin\agentic-knowledge-engine\data\inbox

# SearXNG instance used by `scrape search`.
SCRAPER_SEARXNG_URL=http://localhost:8080

# Reddit (read-only OAuth2 app credentials).
# Create one at https://www.reddit.com/prefs/apps  (type: "script")
SCRAPER_REDDIT_CLIENT_ID=
SCRAPER_REDDIT_CLIENT_SECRET=
SCRAPER_REDDIT_USER_AGENT=vault-scraper/0.1 by u/yourusername

# Optional overrides
SCRAPER_DEFAULT_CONCURRENCY=8
SCRAPER_DEFAULT_TIMEOUT=30
SCRAPER_CHUNK_BYTES=490000